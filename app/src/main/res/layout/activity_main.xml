<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
          스코어보드 카드 (알림과 같은 내용). 가로:세로 2:1 고정 (AspectRatioFrameLayout).
          배경 사진을 고르면: 사진(previewBg) → 어둡게 덮기(previewScrim) → 흰 글씨 스코어보드 순서로 겹침.
          사진은 자르기 화면에서 같은 2:1로 잘라 저장하므로 고른 그대로 보인다.
        -->
        <com.example.lottelock.AspectRatioFrameLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_card">

            <ImageView
                android:id="@+id/previewBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <View
                android:id="@+id/previewScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#8C000000"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/previewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/previewSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="13sp" />

                <FrameLayout
                    android:id="@+id/previewLineScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.example.lottelock.AspectRatioFrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickBg"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pick_background" />

            <Button
                android:id="@+id/btnClearBg"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear_background" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/team_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 팀 선택 토글: 롯데 / 국가대표 -->
        <RadioGroup
            android:id="@+id/teamToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/teamLotte"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/segment_bg"
                android:button="@null"
                android:gravity="center"
                android:text="@string/team_lotte"
                android:textColor="@color/segment_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/teamKorea"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/segment_bg"
                android:button="@null"
                android:gravity="center"
                android:text="@string/team_korea"
                android:textColor="@color/segment_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- 하단 버튼: 모두 같은 스타일, 행·열 간격 8dp (위 토글의 4dp+4dp와 동일) -->
        <Button
            android:id="@+id/btnRefresh"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:text="@string/refresh" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShow"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/show_notification" />

            <Button
                android:id="@+id/btnNotifSettings"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/notification_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDemo"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/demo" />

            <Button
                android:id="@+id/btnStopLive"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/stop_live" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
